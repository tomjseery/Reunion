<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseAppHost>false</UseAppHost>
    <ReunionPackageVersion Condition="'$(ReunionPackageVersion)' == ''">0.1.0-alpha.1</ReunionPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Reunion" Version="$(ReunionPackageVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(VerifyAmbiguousConversions)' == 'true'">
    <Compile Include="..\AmbiguousConversionContracts.cs" Link="AmbiguousConversionContracts.cs" />
  </ItemGroup>

</Project>
